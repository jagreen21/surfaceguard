[Unit]
Description=Cat Guard (ultrasonic deterrent + detection)
After=network-online.target pigpiod.service
Wants=network-online.target

[Service]
User=pi
Group=pi
WorkingDirectory=/home/pi/catdetector
ExecStart=/usr/bin/python3 /home/pi/catdetector/cat_guard.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
